fn main
    // Simple
    if condition
        x = 1
    end

    // Full-form
    if first
        x = 1
    else if second
        x = 2
    else if third
        x = 3
    else
        x = 4
    end

    // Nested
    if first
        if second
            foo()
        else
            bar()
        end
    end
end